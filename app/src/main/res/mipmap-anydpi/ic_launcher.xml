<?xml version="1.0" encoding="utf-8"?>
<!-- Full icon (background + mark) for Android 7.x devices that lack adaptive icons. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle"><gradient android:angle="315" android:startColor="#3A7BFF" android:endColor="#6A4BEF" /><corners android:radius="18dp" /></shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
