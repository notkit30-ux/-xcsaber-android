<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.XCSABER" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/xc_blue</item>
        <item name="colorOnPrimary">@color/xc_surface</item>
        <item name="colorPrimaryContainer">@color/xc_blue_light</item>
        <item name="colorOnPrimaryContainer">@color/xc_on_surface</item>
        <item name="colorSecondary">@color/xc_cyan</item>
        <item name="colorSurface">@color/xc_surface</item>
        <item name="colorOnSurface">@color/xc_on_surface</item>
        <item name="colorSurfaceVariant">@color/xc_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/xc_muted</item>
        <item name="colorOutline">@color/xc_outline</item>
        <item name="colorError">@color/xc_error</item>
        <item name="android:colorBackground">@color/xc_surface</item>
        <item name="android:statusBarColor">@color/xc_surface</item>
        <item name="android:navigationBarColor">@color/xc_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- Splash screen (AndroidX core-splashscreen). Shows the original XCSABER logo. -->
    <style name="Theme.XCSABER.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.XCSABER</item>
    </style>
</resources>
