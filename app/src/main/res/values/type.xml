<?xml version="1.0" encoding="utf-8"?>
<!-- XCSABER type styles. System sans-serif keeps the app light and fast on low-end phones. -->
<resources>
    <style name="TextAppearance.Xc.Wordmark" parent="">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">@color/xc_on_surface</item>
    </style>
    <style name="TextAppearance.Xc.Headline" parent="">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/xc_on_surface</item>
    </style>
    <style name="TextAppearance.Xc.Title" parent="">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/xc_on_surface</item>
    </style>
    <style name="TextAppearance.Xc.Body" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/xc_on_surface</item>
    </style>
    <style name="TextAppearance.Xc.BodySmall" parent="">
        <item name="android:textSize">@dimen/text_body_s</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/xc_muted</item>
    </style>
    <style name="TextAppearance.Xc.Caption" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/xc_muted</item>
    </style>
    <style name="TextAppearance.Xc.Overline" parent="">
        <item name="android:textSize">@dimen/text_overline</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/xc_faint</item>
    </style>
    <style name="TextAppearance.Xc.Stat" parent="">
        <item name="android:textSize">@dimen/text_stat</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/xc_on_surface</item>
    </style>
    <style name="TextAppearance.Xc.Button" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="TextAppearance.Xc.Tab" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TextAppearance.Xc.Chip" parent="">
        <item name="android:textSize">@dimen/text_body_s</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
