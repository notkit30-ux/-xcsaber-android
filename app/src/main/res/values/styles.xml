<?xml version="1.0" encoding="utf-8"?>
<!-- XCSABER component styles. Layouts should use these instead of ad-hoc attributes. -->
<resources>

    <!-- ===== Dialogs and sheets ===== -->
    <style name="ThemeOverlay.Xc.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Xc.BottomSheet</item>
        <item name="android:navigationBarColor">@color/xc_surface_raised</item>
    </style>
    <style name="Widget.Xc.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/xc_surface_raised</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Xc.Sheet</item>
    </style>
    <style name="ShapeAppearance.Xc.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_xl</item>
        <item name="cornerSizeTopRight">@dimen/radius_xl</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="ThemeOverlay.Xc.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/xc_surface_raised</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Xc.Dialog</item>
    </style>
    <style name="ShapeAppearance.Xc.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_l</item>
    </style>
    <style name="Widget.Xc.Snackbar" parent="Widget.Material3.Snackbar" />

    <!-- ===== Buttons ===== -->
    <style name="Widget.Xc.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAppearance">@style/TextAppearance.Xc.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="backgroundTint">@color/xc_blue</item>
        <item name="android:textColor">@color/xc_on_accent</item>
    </style>
    <style name="Widget.Xc.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAppearance">@style/TextAppearance.Xc.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="backgroundTint">@color/xc_blue_tint</item>
        <item name="android:textColor">@color/xc_blue</item>
        <item name="iconTint">@color/xc_blue</item>
    </style>
    <style name="Widget.Xc.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAppearance">@style/TextAppearance.Xc.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="strokeColor">@color/xc_outline</item>
        <item name="android:textColor">@color/xc_on_surface</item>
        <item name="iconTint">@color/xc_on_surface</item>
    </style>
    <style name="Widget.Xc.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAppearance">@style/TextAppearance.Xc.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/xc_blue</item>
    </style>
    <style name="Widget.Xc.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch_min</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <!-- ===== Chips ===== -->
    <style name="Widget.Xc.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAppearance">@style/TextAppearance.Xc.Chip</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">@dimen/radius_l</item>
    </style>

    <!-- ===== Switch ===== -->
    <style name="Widget.Xc.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch" />

    <!-- ===== Cards ===== -->
    <style name="Widget.Xc.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/xc_surface_raised</item>
        <item name="cardCornerRadius">@dimen/radius_l</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/xc_outline_soft</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ===== Text roles used directly from layouts ===== -->
    <style name="Xc.Text.SectionLabel" parent="TextAppearance.Xc.Overline">
        <item name="android:paddingTop">@dimen/space_4</item>
        <item name="android:paddingBottom">@dimen/space_2</item>
    </style>

    <!-- ===== Home quick actions and page navigation ===== -->
    <style name="Widget.Xc.QuickAction" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:paddingTop">@dimen/space_2</item>
        <item name="android:paddingBottom">@dimen/space_2</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Widget.Xc.QuickActionIcon" parent="">
        <item name="android:layout_width">@dimen/tile_l</item>
        <item name="android:layout_height">@dimen/tile_l</item>
        <item name="android:padding">14dp</item>
        <item name="android:contentDescription">@null</item>
    </style>
    <style name="Widget.Xc.QuickActionLabel" parent="TextAppearance.Xc.Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/xc_muted</item>
    </style>
    <style name="Widget.Xc.NavButton" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">13dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/xc_on_surface</item>
    </style>
    <style name="Widget.Xc.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/xc_blue_tint</item>
    </style>

    <!-- ===== Privacy Center stat tiles ===== -->
    <style name="Widget.Xc.StatTile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_3</item>
    </style>
    <style name="Widget.Xc.StatValue" parent="TextAppearance.Xc.Stat">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/xc_blue</item>
    </style>
    <style name="Widget.Xc.StatLabel" parent="TextAppearance.Xc.Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>
</resources>
