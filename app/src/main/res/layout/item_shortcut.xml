<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_2"
    android:paddingBottom="@dimen/space_2">

    <FrameLayout
        android:layout_width="@dimen/tile_l"
        android:layout_height="@dimen/tile_l"
        android:background="@drawable/bg_card">

        <TextView
            android:id="@+id/shortcutInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/xc_blue"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />
    </FrameLayout>

    <TextView
        android:id="@+id/shortcutTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textAppearance="@style/TextAppearance.Xc.Caption" />
</LinearLayout>
