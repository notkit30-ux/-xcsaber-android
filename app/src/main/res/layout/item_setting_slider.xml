<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_5"
    android:paddingTop="@dimen/space_3"
    android:paddingEnd="@dimen/space_5"
    android:paddingBottom="@dimen/space_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/settingIcon"
            android:layout_width="@dimen/tile_s"
            android:layout_height="@dimen/tile_s"
            android:background="@drawable/bg_tile_blue"
            android:contentDescription="@null"
            android:padding="9dp"
            app:tint="@color/xc_blue" />

        <TextView
            android:id="@+id/settingTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Xc.Body" />

        <TextView
            android:id="@+id/settingValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Xc.Title"
            android:textColor="@color/xc_blue" />
    </LinearLayout>

    <TextView
        android:id="@+id/settingSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:textAppearance="@style/TextAppearance.Xc.Caption" />

    <com.google.android.material.slider.Slider
        android:id="@+id/settingSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:thumbColor="@color/xc_blue"
        app:trackColorActive="@color/xc_blue"
        app:trackColorInactive="@color/xc_outline" />
</LinearLayout>
