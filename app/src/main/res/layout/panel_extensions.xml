<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_4">

        <ImageButton
            android:id="@+id/exBack"
            style="@style/Widget.Xc.IconButton"
            android:contentDescription="@string/cd_back_panel"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/extensions_center"
            android:textAppearance="@style/TextAppearance.Xc.Headline" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            android:paddingBottom="@dimen/space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/bg_hero"
                android:orientation="vertical"
                android:padding="@dimen/space_5">

                <ImageView
                    android:layout_width="@dimen/tile_m"
                    android:layout_height="@dimen/tile_m"
                    android:background="@drawable/bg_circle"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_extension"
                    app:tint="@color/xc_blue" />

                <TextView
                    android:id="@+id/exSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:textAppearance="@style/TextAppearance.Xc.Headline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="Plugins are native XCSABER features that ship inside the app and run only code we built. Chrome and Firefox extensions are not supported by Android WebView, so they can't be installed here."
                    android:textAppearance="@style/TextAppearance.Xc.BodySmall" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/exList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
