<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_4">

        <ImageButton
            android:id="@+id/pcBack"
            style="@style/Widget.Xc.IconButton"
            android:contentDescription="@string/cd_back_panel"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/privacy_center"
            android:textAppearance="@style/TextAppearance.Xc.Headline" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            android:paddingBottom="@dimen/space_8">

            <!-- Hero: master switch -->
            <LinearLayout
                android:id="@+id/pcHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/bg_hero"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_5">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp">

                    <View
                        android:id="@+id/pcGlow"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/bg_glow_ring" />

                    <ImageView
                        android:id="@+id/pcShield"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle"
                        android:contentDescription="@null"
                        android:padding="16dp"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/xc_blue" />
                </FrameLayout>

                <TextView
                    android:id="@+id/pcStatusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Xc.Headline" />

                <TextView
                    android:id="@+id/pcStatusBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Xc.BodySmall" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/pcMasterSwitch"
                    style="@style/Widget.Xc.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:minHeight="@dimen/touch_min"
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:contentDescription="Ad and tracker blocking" />
            </LinearLayout>

            <!-- Honest counters -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/Widget.Xc.StatTile">

                    <TextView
                        android:id="@+id/pcStatPage"
                        style="@style/Widget.Xc.StatValue" />

                    <TextView
                        style="@style/Widget.Xc.StatLabel"
                        android:text="@string/unit_blocked_page" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.Xc.StatTile"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_marginEnd="@dimen/space_2">

                    <TextView
                        android:id="@+id/pcStatSession"
                        style="@style/Widget.Xc.StatValue" />

                    <TextView
                        style="@style/Widget.Xc.StatLabel"
                        android:text="@string/unit_blocked_session" />
                </LinearLayout>

                <LinearLayout style="@style/Widget.Xc.StatTile">

                    <TextView
                        android:id="@+id/pcStatTotal"
                        style="@style/Widget.Xc.StatValue" />

                    <TextView
                        style="@style/Widget.Xc.StatLabel"
                        android:text="@string/unit_blocked_total" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/pcStatNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:paddingStart="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.Xc.Caption" />

            <!-- Blocklist -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Xc.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tracker blocklist"
                        android:textAppearance="@style/TextAppearance.Xc.Title" />

                    <LinearLayout
                        android:id="@+id/pcListInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:orientation="vertical" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/pcUpdateProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/xc_blue"
                        app:trackColor="@color/xc_outline_soft"
                        app:trackCornerRadius="2dp" />

                    <TextView
                        android:id="@+id/pcUpdateStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:textAppearance="@style/TextAppearance.Xc.Caption"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pcUpdateButton"
                        style="@style/Widget.Xc.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="@string/update_tracker_list"
                        app:icon="@drawable/ic_refresh"
                        app:iconTint="@color/xc_on_accent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Summary of what is active -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Xc.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What protects you right now"
                        android:textAppearance="@style/TextAppearance.Xc.Title" />

                    <LinearLayout
                        android:id="@+id/pcSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Controls -->
            <LinearLayout
                android:id="@+id/pcControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-16dp"
                android:layout_marginTop="@dimen/space_2"
                android:layout_marginEnd="-16dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/pcHonesty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/bg_tile_warn"
                android:padding="@dimen/space_4"
                android:text="@string/privacy_honesty"
                android:textAppearance="@style/TextAppearance.Xc.BodySmall" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
