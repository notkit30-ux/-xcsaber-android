<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_1"
        android:paddingEnd="@dimen/space_4">

        <ImageButton
            android:id="@+id/stBack"
            style="@style/Widget.Xc.IconButton"
            android:contentDescription="@string/cd_back_panel"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings"
            android:textAppearance="@style/TextAppearance.Xc.Headline" />
    </LinearLayout>

    <EditText
        android:id="@+id/stSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginTop="@dimen/space_1"
        android:layout_marginEnd="@dimen/space_4"
        android:background="@drawable/bg_search_pill"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="@dimen/space_2"
        android:drawableTint="@color/xc_muted"
        android:hint="@string/settings_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:textColor="@color/xc_on_surface"
        android:textColorHint="@color/xc_faint"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/stEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_6"
        android:text="@string/settings_no_results"
        android:textAppearance="@style/TextAppearance.Xc.BodySmall"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/stList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/space_8" />
</LinearLayout>
