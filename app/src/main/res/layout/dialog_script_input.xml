<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_6"
    android:paddingTop="@dimen/space_2"
    android:paddingEnd="@dimen/space_6">

    <EditText
        android:id="@+id/scriptInputField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|start"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:maxLines="8"
        android:minHeight="@dimen/touch_min"
        android:textColor="@color/xc_on_surface"
        android:textColorHint="@color/xc_faint"
        android:textSize="13sp" />
</FrameLayout>
